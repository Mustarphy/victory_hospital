# Copy to .env and fill in the values from your EmailJS dashboard (https://dashboard.emailjs.com/).
# Never commit .env. See docs/EMAILJS.md for the full setup.

# Email Services > your Gmail service > Service ID
VITE_EMAILJS_SERVICE_ID=

# Email Templates > "New appointment request" template > Template ID
VITE_EMAILJS_TEMPLATE_ID=

# Account > General > Public Key (designed to be used in the browser)
VITE_EMAILJS_PUBLIC_KEY=

# Optional: Email Templates > "Patient acknowledgement" template > Template ID.
# Leave empty to send only the hospital notification.
VITE_EMAILJS_PATIENT_TEMPLATE_ID=
